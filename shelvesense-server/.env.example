# Copy to .env — never commit real keys
PORT=8787
NODE_ENV=development

# OpenAI (vision + text). Optional when AI_ENGINE=mock (offline heuristics).
OPENAI_API_KEY=sk-your-key-here

# AI: auto | openai | mock
# - auto: OpenAI when key set, else MockAiProvider (deterministic heuristics — free, local logic).
# - openai: require OPENAI_API_KEY.
# - mock: always offline heuristics (CI / beginners).
AI_ENGINE=auto

# Speech: auto | openai | edge
TTS_ENGINE=auto
TTS_EDGE_VOICE=en-US-AriaNeural

OPENAI_VISION_MODEL=gpt-4o
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# SQLite session store (cart + profile). Set SQLITE_ENABLED=false for RAM-only.
SQLITE_ENABLED=true
SQLITE_PATH=./data/shelvesense.db

# OCR (tesseract.js) for POST /api/profile/ocr — first run downloads language data.
OCR_ENABLED=true
# Resize / normalize / sharpen before OCR (recommended for real packaging + shelves).
OCR_PREPROCESS=true

CORS_ORIGINS=
